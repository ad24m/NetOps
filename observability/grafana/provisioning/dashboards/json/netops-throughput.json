{
  "id": null,
  "uid": "netops-o3-throughput",
  "title": "NetOps - Débit des interfaces",
  "tags": [
    "NetOps",
    "O3"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Équipement",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(interfaces_interface_state_counters_in_octets, source)",
        "query": "label_values(interfaces_interface_state_counters_in_octets, source)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "interface",
        "label": "Interface",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(interfaces_interface_state_counters_in_octets{source=~\"$device\"}, interface_name)",
        "query": "label_values(interfaces_interface_state_counters_in_octets{source=~\"$device\"}, interface_name)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "Ethernet1",
          "value": "Ethernet1"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Débit reçu (RX)",
      "description": "Débit entrant calculé à partir du compteur d’octets reçus.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "8 * rate(interfaces_interface_state_counters_in_octets{source=~\"$device\", interface_name=~\"$interface\"}[5m])",
          "legendFormat": "{{source}} / {{interface_name}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Débit émis (TX)",
      "description": "Débit sortant calculé à partir du compteur d’octets émis.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "8 * rate(interfaces_interface_state_counters_out_octets{source=~\"$device\", interface_name=~\"$interface\"}[5m])",
          "legendFormat": "{{source}} / {{interface_name}}",
          "range": true
        }
      ]
    }
  ]
}
